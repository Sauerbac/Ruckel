{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Ruckel",
  "version": "1.0.0",
  "identifier": "de.auerbach.ruckel",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Ruckel",
        "width": 860,
        "height": 560,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
